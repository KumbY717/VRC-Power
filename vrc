#!/usr/bin/env bash
# VRC Power helper.   ./vrc help
set -euo pipefail
cd "$(dirname "$0")"
if [ -f web/pnpm-lock.yaml ]; then PM=pnpm; else PM=npm; fi
WEB="web"

case "${1:-help}" in
  apply)   shift; python3 tools/apply.py "$@" ;;           # clipboard -> files
  undo)    python3 tools/apply.py --undo ;;                # revert last apply
  dev)     cd $WEB && $PM run dev ;;                       # start dev server
  check)   cd $WEB && npx --no-install tsc --noEmit && $PM run lint && echo "OK: types + lint pass" ;;
  build)   cd $WEB && $PM run build ;;
  add)     shift; cd $WEB && if [ "$PM" = pnpm ]; then pnpm add "$@"; else npm install "$@"; fi ;;
  save)    shift; git add -A && git commit -qm "${*:-checkpoint}" && echo "committed: ${*:-checkpoint}" ;;
  tree)    find . -type f -not -path '*/node_modules/*' -not -path './.git/*' -not -path '*/.next/*' -not -path './.vrc-backup/*' -not -name 'pnpm-lock.yaml' -not -name 'package-lock.json' | sort ;;
  help|*)  cat <<'H'
./vrc apply [file]   write files from my code block (reads clipboard if no file)
./vrc apply --dry-run   preview what would change
./vrc undo           revert the last apply
./vrc dev            run the app at http://localhost:3000
./vrc check          typecheck + lint (paste errors back to me)
./vrc build          production build
./vrc add <pkg...>   install a package into web/
./vrc save "msg"     git commit checkpoint
./vrc tree           list project files
H
  ;;
esac
